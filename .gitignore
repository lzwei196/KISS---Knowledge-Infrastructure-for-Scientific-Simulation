# Python bytecode. 31 .pyc files were tracked, all under ki_tools_common — they
# are platform-stamped (cpython-312), rebuilt on import, and a stale one can
# shadow a module whose source has just been updated.
__pycache__/
*.py[cod]

# Editor backups. Seven .bak files were tracked, referenced by nothing.
*.bak
*.bak.*
*.orig
*~

# Build output. PyInstaller writes these; the release workflow builds from a
# clean checkout, so they only ever arrive by accident from a local build.
build/
dist/
*.spec
.build-venv/
*.egg-info/

# Model run residue. Running a model from the repository root leaves these:
# ERROR.OUT, fort.502, LUN.LST and WARNING.OUT all reached a commit this way.
ERROR.OUT
WARNING.OUT
LUN.LST
fort.*

# macOS
.DS_Store
